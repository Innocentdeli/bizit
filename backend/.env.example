# Serper Config (Google Search API)
SERPER_API_KEY=your_serper_api_key_here

# Shopify Configuration
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_STORE_URL=https://your-store.myshopify.com

# Stripe Configuration
STRIPE_API_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# QuickBooks Configuration (OAuth 2.0)
QUICKBOOKS_CLIENT_ID=your_client_id_here
QUICKBOOKS_CLIENT_SECRET=your_client_secret_here
QUICKBOOKS_REDIRECT_URI=http://localhost:8000/integrations/quickbooks/callback

# Plaid Configuration
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_secret_here
PLAID_ENV=sandbox  # or development, production

# Salesforce Configuration (OAuth 2.0)
SALESFORCE_CLIENT_ID=your_client_id_here
SALESFORCE_CLIENT_SECRET=your_client_secret_here
SALESFORCE_INSTANCE_URL=https://your-instance.salesforce.com

# SAP Configuration
SAP_API_KEY=your_api_key_here
SAP_BASE_URL=https://your-sap-instance.com

# ==================== FOREX TRADING ====================
# OANDA Forex Trading API
# Get your API key from: https://www.oanda.com/account/tpa/personal_token
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_ENV=practice  # practice or live

# ==================== MARKETING OS CHANNEL INTEGRATIONS ====================
# All of these are optional — every integration fails closed (reports unsent/
# unconfigured rather than faking success) when its keys are missing.

# SendGrid — real transactional/retention email sends
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=organism@yourdomain.com
SENDGRID_FROM_NAME=BIZIT Organism

# Africa's Talking — real SMS sends
AFRICASTALKING_API_KEY=your_africastalking_api_key_here
AFRICASTALKING_USERNAME=your_africastalking_username_here

# Paystack — real contractor payouts (Transfers API)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# Meta Marketing API — creates PAUSED ad campaign shells only; ad sets,
# targeting, and creative still need manual setup in Meta Ads Manager
META_ACCESS_TOKEN=your_meta_marketing_api_access_token_here
META_AD_ACCOUNT_ID=your_meta_ad_account_id_here  # numeric id, no "act_" prefix

# ==================== COGNITIVE CORE (LLM) ====================
# Using Local Sovereign AI via Ollama
# Ensure Ollama is running: `ollama serve`
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
